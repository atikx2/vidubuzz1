{
  "name": "vidubuzz-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "pages:dev": "wrangler pages dev out --d1 DB=local-admin --compatibility-date 2026-10-08 --ip 0.0.0.0 --port 8788",
    "db:local": "wrangler d1 execute DB --config wrangler.local.jsonc --local --file migrations/0001_admin_analytics.sql"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
